---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  /** Título de la pestaña del navegador. Corto: se trunca enseguida. */
  title: string;
  /** Título al compartir el enlace (WhatsApp, LinkedIn…). Aquí sí conviene
   *  el gancho completo, porque es lo que se lee antes de entrar.
   *  Si no se pasa, cae en `title`. */
  ogTitle?: string;
  description?: string;
}

const {
  title,
  ogTitle = title,
  description = 'VIBA TECH — plataforma SaaS que acelera la inducción y la comunicación interna del personal operativo. Queremos entender cómo las MYPES incorporan y capacitan a su gente.',
} = Astro.props;

// URLs absolutas (dependen del `site` definido en astro.config.mjs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);

// Structured data: posiciona a VIBA TECH como plataforma SaaS B2B / EdTech
// para inducción y capacitación de personal operativo.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'VIBA TECH',
  applicationCategory: 'BusinessApplication',
  description,
  url: Astro.site?.href,
  image: ogImage.href,
  slogan: 'Capacita. Alinea. Crece.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'PEN',
    description: 'Participación sin costo en el estudio de onboarding para MYPES',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VIBA TECH',
    url: Astro.site?.href,
    logo: ogImage.href,
    slogan: 'Capacita. Alinea. Crece.',
    areaServed: 'Perú',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+51976799578',
      contactType: 'customer service',
      availableLanguage: ['Spanish'],
    },
  },
  keywords: [
    'onboarding de personal operativo',
    'capacitación para MYPES',
    'inducción de personal',
    'comunicación interna',
    'micro-learning por WhatsApp',
    'EdTech',
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (cómo se ve al compartir en WhatsApp, LinkedIn, etc.) -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta
      property="og:image:alt"
      content="VIBA TECH — Tu experiencia construye lo que sí sirve"
    />
    <meta property="og:site_name" content="VIBA TECH" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data para Google y motores con IA (Gemini, ChatGPT, etc.) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-inter" preload />

    <!-- F-futuro: aquí irá la etiqueta de GA4 -->
  </head>
  <body class="min-h-screen bg-negro font-sans text-hueso antialiased">
    <slot />
  </body>
</html>
