---
import Boton from './Boton.astro';
import Logotipo from './Logotipo.astro';
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-negro/80 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Lockup de marca: isotipo lima + VIBA blanco + TECH lima (manual §9) -->
    <a href="#inicio" class="flex items-center" aria-label="VIBA TECH">
      <Logotipo claseIsotipo="h-9" claseTexto="text-lg" />
    </a>

    <!-- Nav -->
    <nav
      class="hidden items-center gap-8 text-sm font-medium text-hueso/70 md:flex"
    >
      <a href="#inicio" class="transition hover:text-lima">Inicio</a>
      <a href="#participar" class="transition hover:text-lima">Participar</a>
    </nav>

    <Boton variante="primario" href="#participar" class="!px-5 !py-2.5">
      Quiero participar
    </Boton>
  </div>
</header>
