---
interface Props {
  variante?: 'primario' | 'secundario' | 'oscuro';
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { variante = 'primario', href, class: clase = '', ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold tracking-wide transition duration-200';

const estilos: Record<string, string> = {
  // CTA principal: lima sólido sobre negro.
  primario:
    'bg-lima text-negro hover:bg-lima-claro hover:-translate-y-0.5',
  // Secundario: contorno sobre superficie oscura.
  secundario:
    'border border-lima/35 text-hueso hover:border-lima hover:bg-lima/10 hover:text-lima',
  // Terciario: superficie de tarjeta, para barras y headers.
  oscuro:
    'bg-carbon text-hueso ring-1 ring-inset ring-white/10 hover:bg-lima hover:text-negro hover:ring-lima',
};

const cls = [base, estilos[variante], clase].join(' ');
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class={cls} {...rest}>
      <slot />
    </button>
  )
}
