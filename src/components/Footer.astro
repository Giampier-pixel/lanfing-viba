---
import Logotipo from './Logotipo.astro';

const anio = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-carbon text-hueso/75">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div
      class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center"
    >
      <div class="flex flex-col gap-3">
        <Logotipo claseIsotipo="h-12" claseTexto="text-2xl" />
        <span
          class="text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-lima/80"
        >
          Capacita · Alinea · Crece
        </span>
      </div>

      <nav class="flex gap-6 text-sm">
        <a href="#inicio" class="transition hover:text-lima">Inicio</a>
        <a href="#participar" class="transition hover:text-lima">Participar</a>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col justify-between gap-2 border-t border-white/10 pt-6 text-xs text-hueso/40 sm:flex-row"
    >
      <span>© {anio} VIBA TECH. Todos los derechos reservados.</span>
      <a href="#" class="transition hover:text-lima">Política de privacidad</a>
    </div>
  </div>
</footer>
