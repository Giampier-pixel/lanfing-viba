# Google Sheets (ya en uso por /api/lead)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API (bot)
# Token que tú inventas y también pegas en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración > Básica). Firma los webhooks.
WHATSAPP_APP_SECRET=
# Token de acceso permanente del usuario de sistema.
WHATSAPP_TOKEN=
# ID del número de WhatsApp Business que envía (NO el número telefónico).
WHATSAPP_PHONE_ID=
# Opcional: versión de Graph API (por defecto v23.0).
WHATSAPP_API_VERSION=
